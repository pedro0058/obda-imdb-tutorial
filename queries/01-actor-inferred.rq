# title: Inferred typing of :Actor (no rdf:type :Actor triple in the mappings)
# question: How many actors are there in the database?
# show-sql: yes
# sql: SELECT COUNT(DISTINCT actor_id) AS n FROM roles
PREFIX : <http://www.example.org/imdb#>

SELECT (COUNT(DISTINCT ?x) AS ?n)
WHERE { ?x a :Actor }
