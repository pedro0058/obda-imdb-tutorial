@prefix :        <http://www.example.org/imdb#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

#################################################################
#    Ontology metadata
#################################################################

<http://www.example.org/imdb> a owl:Ontology ;
    owl:versionIRI <http://www.example.org/imdb/0.1.0> ;
    owl:versionInfo "0.1.0" ;
    dcterms:title "Ontologia IMDB (imdb_ijs)"@pt , "IMDB Ontology (imdb_ijs)"@en ;
    dcterms:description "Ontologia leve (OWL 2 QL) para acesso a dados baseado em ontologias (OBDA) com Ontop sobre o dataset relacional imdb_ijs."@pt , "Lightweight ontology (OWL 2 QL) for ontology-based data access (OBDA) with Ontop over the imdb_ijs relational dataset."@en ;
    dcterms:creator "pedro0058" ;
    dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:created "2026-09-14"^^xsd:date ;
    dcterms:source <https://relational.fel.cvut.cz/dataset/IMDb> ;
    vann:preferredNamespacePrefix "imdb" ;
    vann:preferredNamespaceUri "http://www.example.org/imdb#" ;
    rdfs:comment "Ontologia leve (OWL 2 QL) para o dataset IMDB (imdb_ijs), reaproveitando termos do FOAF sem importar o arquivo OWL completo dessa ontologia."@pt , "Lightweight ontology (OWL 2 QL) for the IMDB dataset (imdb_ijs), reusing FOAF terms without importing that ontology's full OWL file."@en .

dcterms:title a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:source a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .

#################################################################
#    Reused terms (FOAF)
#    Declared exactly as in the FOAF 0.99 specification, with no
#    extra axioms, so as not to constrain third-party terms.
#################################################################

foaf:Person a owl:Class .
foaf:givenName a owl:DatatypeProperty .
foaf:familyName a owl:DatatypeProperty ; rdfs:domain foaf:Person ; rdfs:range rdfs:Literal .

#################################################################
#    Classes
#################################################################

:Actor a owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Ator"@pt , "Actor"@en ;
    rdfs:comment "Pessoa que atuou em pelo menos um filme (inferido via domínio de :actedIn, não materializado na fonte)."@pt , "Person who acted in at least one film (inferred through the domain of :actedIn, not materialized in the source)."@en .

:Director a owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Diretor"@pt , "Director"@en ;
    rdfs:comment "Pessoa que dirigiu pelo menos um filme (inferido via domínio de :directed)."@pt , "Person who directed at least one film (inferred through the domain of :directed)."@en .

:Movie a owl:Class ;
    rdfs:label "Filme"@pt , "Movie"@en ;
    rdfs:comment "Uma obra audiovisual catalogada no IMDb. Vem da tabela movies."@pt , "An audiovisual work catalogued on IMDb. Comes from the movies table."@en .

:Genre a owl:Class ;
    rdfs:label "Gênero cinematográfico"@pt , "Film genre"@en ;
    rdfs:comment "Um gênero cinematográfico, tratado como indivíduo (não como literal) para permitir navegação e futura hierarquia."@pt , "A film genre, treated as an individual (not as a literal) to allow navigation and a future hierarchy."@en .

:Performance a owl:Class ;
    rdfs:label "Atuação"@pt , "Performance"@en ;
    rdfs:comment "Participação de um ator em um filme interpretando um personagem (padrão de relação n-ária do W3C). Vem da tabela roles: cada linha (actor_id, movie_id, role) é uma atuação. Complementa :actedIn, que é o atalho binário ator→filme."@pt , "An actor's participation in a film playing a character (the W3C n-ary relation pattern). Comes from the roles table: each row (actor_id, movie_id, role) is one performance. It complements :actedIn, the binary actor->film shortcut."@en .

:GenreAffinity a owl:Class ;
    rdfs:label "Afinidade de gênero"@pt , "Genre affinity"@en ;
    rdfs:comment "Relação qualificada entre um diretor e um gênero, com um escore (padrão de relação n-ária do W3C). Vem da tabela directors_genres. Complementa :hasGenreAffinity, que é o atalho binário diretor→gênero."@pt , "A qualified relation between a director and a genre, carrying a score (the W3C n-ary relation pattern). Comes from the directors_genres table. It complements :hasGenreAffinity, the binary director->genre shortcut."@en .

#################################################################
#    Object properties
#################################################################

:actedIn a owl:ObjectProperty ;
    rdfs:domain :Actor ;
    rdfs:range :Movie ;
    rdfs:label "atuou em"@pt , "acted in"@en ;
    rdfs:comment "Vem da tabela roles. Ninguém é explicitamente tipado :Actor na fonte — o tipo é inferido pelo domínio desta propriedade."@pt , "Comes from the roles table. Nobody is explicitly typed :Actor in the source - the type is inferred from the domain of this property."@en .

:hasActor a owl:ObjectProperty ;
    owl:inverseOf :actedIn ;
    rdfs:label "tem ator"@pt , "has actor"@en ;
    rdfs:comment "Inversa de :actedIn."@pt , "Inverse of :actedIn."@en .

:directed a owl:ObjectProperty ;
    rdfs:domain :Director ;
    rdfs:range :Movie ;
    rdfs:label "dirigiu"@pt , "directed"@en ;
    rdfs:comment "Vem de movies_directors. Mesmo padrão de inferência de tipo que :actedIn."@pt , "Comes from movies_directors. The same type inference pattern as :actedIn."@en .

:hasDirector a owl:ObjectProperty ;
    owl:inverseOf :directed ;
    rdfs:label "tem diretor"@pt , "has director"@en ;
    rdfs:comment "Inversa de :directed."@pt , "Inverse of :directed."@en .

:hasGenre a owl:ObjectProperty ;
    rdfs:domain :Movie ;
    rdfs:range :Genre ;
    rdfs:label "tem gênero"@pt , "has genre"@en ;
    rdfs:comment "Vem de movies_genres."@pt , "Comes from movies_genres."@en .

:hasGenreAffinity a owl:ObjectProperty ;
    rdfs:domain :Director ;
    rdfs:range :Genre ;
    rdfs:label "tem afinidade com o gênero"@pt , "has genre affinity"@en ;
    rdfs:comment "Vem de directors_genres. Propriedade distinta de :hasGenre para não confundir 'gênero do filme' com 'afinidade do diretor a um gênero'."@pt , "Comes from directors_genres. A property distinct from :hasGenre, so that 'the genre of the film' is not confused with 'the director's affinity with a genre'."@en .

:performer a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Actor ;
    rdfs:label "intérprete"@pt , "performer"@en ;
    rdfs:comment "Liga uma atuação ao ator. Vem de roles.actor_id. O range também tipa o ator como :Actor por inferência."@pt , "Links a performance to the actor. Comes from roles.actor_id. The range also types the actor as :Actor by inference."@en .

:performanceIn a owl:ObjectProperty ;
    rdfs:domain :Performance ;
    rdfs:range :Movie ;
    rdfs:label "atuação no filme"@pt , "performance in"@en ;
    rdfs:comment "Liga uma atuação ao filme. Vem de roles.movie_id."@pt , "Links a performance to the film. Comes from roles.movie_id."@en .

:affinityDirector a owl:ObjectProperty ;
    rdfs:domain :GenreAffinity ;
    rdfs:range :Director ;
    rdfs:label "diretor da afinidade"@pt , "affinity director"@en ;
    rdfs:comment "Liga uma afinidade de gênero ao diretor. Vem de directors_genres.director_id."@pt , "Links a genre affinity to the director. Comes from directors_genres.director_id."@en .

:affinityGenre a owl:ObjectProperty ;
    rdfs:domain :GenreAffinity ;
    rdfs:range :Genre ;
    rdfs:label "gênero da afinidade"@pt , "affinity genre"@en ;
    rdfs:comment "Liga uma afinidade de gênero ao gênero. Vem de directors_genres.genre."@pt , "Links a genre affinity to the genre. Comes from directors_genres.genre."@en .

#################################################################
#    Data properties
#################################################################

:title a owl:DatatypeProperty ;
    rdfs:domain :Movie ;
    rdfs:range xsd:string ;
    rdfs:label "título"@pt , "title"@en ;
    rdfs:comment "Título do filme. Vem de movies.name."@pt , "Title of the film. Comes from movies.name."@en .

:releaseYear a owl:DatatypeProperty ;
    rdfs:domain :Movie ;
    rdfs:range xsd:integer ;
    rdfs:label "ano de lançamento"@pt , "release year"@en ;
    rdfs:comment "Ano de lançamento do filme. Vem de movies.year."@pt , "Release year of the film. Comes from movies.year."@en .

:rank a owl:DatatypeProperty ;
    rdfs:domain :Movie ;
    rdfs:range xsd:decimal ;
    rdfs:label "nota IMDb"@pt , "IMDb rank"@en ;
    rdfs:comment "Nota média do filme no IMDb, de 1 a 9.9. Vem de movies.rank; ausente para a maioria dos filmes (NULL na fonte, sem tripla gerada)."@pt , "Average IMDb rating of the film, from 1 to 9.9. Comes from movies.rank; absent for most films (NULL in the source, no triple generated)."@en .

:characterName a owl:DatatypeProperty ;
    rdfs:domain :Performance ;
    rdfs:range xsd:string ;
    rdfs:label "nome do personagem"@pt , "character name"@en ;
    rdfs:comment "Personagem interpretado na atuação. Vem de roles.role; strings vazias na fonte não geram tripla."@pt , "Character played in the performance. Comes from roles.role; empty strings in the source generate no triple."@en .

:affinityScore a owl:DatatypeProperty ;
    rdfs:domain :GenreAffinity ;
    rdfs:range xsd:decimal ;
    rdfs:label "escore de afinidade"@pt , "affinity score"@en ;
    rdfs:comment "Escore da afinidade do diretor ao gênero, em (0, 1]. Vem de directors_genres.prob."@pt , "Score of the director's affinity with the genre, in (0, 1]. Comes from directors_genres.prob."@en .
